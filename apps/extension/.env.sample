# apps/extension — Chrome extension (Parcel)
# Copy to .env and fill in. Everything here is bundled into the published .zip
# and is readable by anyone who installs the extension. Nothing secret.

REACT_APP_SUPABASE_URL=https://xpovcmbrttmkhnrfspvo.supabase.co

# Anon key only. Constrained by row-level security.
REACT_APP_SUPABASE_ANON_KEY=

# The deployed FastAPI backend. Must be reachable from the browser and must
# appear in the API's ALLOWED_ORIGINS.
REACT_APP_BACKEND_URL=http://localhost:8000

# The public web app, linked from the popup's sign-up button.
REACT_APP_WEB_APP_URL=http://localhost:3000

# Optional verbose diagnostics. Leave disabled in published builds.
REACT_APP_DEBUG=false
