{
  "name": "Langfour: Translate & Learn Words",
  "version": "1.2.0",
  "description": "Translate words and add them to your flashcards on YouTube, Netflix and Prime Video, or in a clean reader for any article.",
  "manifest_version": 3,
  "background": {
    "service_worker": "src/backgroundScript.ts",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "src/preferencePopup/index.html"
  },
  "commands": {
    "toggle-reader": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open the reader view for the current page"
    }
  },
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "1024": "icons/icon1024.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*",
        "https://www.youtube.com/*",
        "https://www.primevideo.com/*"
      ],
      "js": [
        "src/contentScript.ts"
      ]
    },
    {
      "matches": [
        "https://app.langfour.com/*",
        "http://localhost:3000/*"
      ],
      "js": [
        "src/siteBridge.ts"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/index.ts",
        "src/index.css",
        "src/youtubeBookmark.ts",
        "src/contentScript.ts",
        "images/demo.webp"
      ],
      "matches": [
        "https://www.netflix.com/*",
        "https://www.youtube.com/*",
        "https://www.primevideo.com/*"
      ]
    },
    {
      "resources": [
        "src/auth_handler.html",
        "src/auth_handler.ts"
      ],
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "resources": [
        "src/auth.html",
        "src/auth.ts",
        "src/reader.html",
        "src/reader.ts",
        "src/reader.css"
      ],
      "matches": [
        "chrome-extension://*/*"
      ]
    }
  ],
  "host_permissions": [
    "https://major-wynny-victorfriedrich-7c04e8cd.koyeb.app/*",
    "https://xpovcmbrttmkhnrfspvo.supabase.co/*"
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "homepage_url": "https://app.langfour.com"
}
