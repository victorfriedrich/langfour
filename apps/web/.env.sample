# apps/web — Next.js
# Copy to .env and fill in. EVERY value here ships to the browser in the JS
# bundle: NEXT_PUBLIC_* is inlined at build time. Nothing secret belongs here.

# Supabase project "Lang" (eu-central-1)
NEXT_PUBLIC_SUPABASE_URL=https://xpovcmbrttmkhnrfspvo.supabase.co

# The anon key is public by design and is constrained by row-level security.
# Dashboard -> Project Settings -> API Keys -> anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The FastAPI backend. Falls back to http://localhost:8000 when unset, which
# is why a missing value here fails silently in production rather than loudly.
NEXT_PUBLIC_API_URL=http://localhost:8000

# NOTE: src/app/components/UrlParser.tsx reads REACT_APP_API_URL instead of
# NEXT_PUBLIC_API_URL. Next.js only inlines NEXT_PUBLIC_* into the browser
# bundle, so that read is always undefined and the component silently falls
# back to localhost:8000 in production. Fix the component -- do not add a
# REACT_APP_API_URL here, it cannot work.
