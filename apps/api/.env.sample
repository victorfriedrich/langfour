# apps/api — FastAPI
# Copy to .env and fill in. This file is SERVER-SIDE ONLY. Several of these
# values bypass row-level security or bill real money; none of them may ever
# appear in apps/web or apps/extension, both of which ship to users.
#
# Production (Koyeb) sets these as environment variables, not as a file.

# ---------------------------------------------------------------------------
# Supabase — REQUIRED
# ---------------------------------------------------------------------------
SUPABASE_URL=https://xpovcmbrttmkhnrfspvo.supabase.co

# service_role bypasses RLS entirely. Treat it like a root password.
# Dashboard -> Project Settings -> API Keys -> service_role -> Reveal
#
# supabase_client.py reads the key's own `role` claim at startup and refuses
# to boot if it is not service_role, because the failure mode is otherwise
# silent: with RLS on, an anon key returns zero rows with HTTP 200.
# (SUPABASE_KEY is still accepted as a deprecated alias, with a warning.)
SUPABASE_SERVICE_ROLE_KEY=

# Keep at 1. Set to 0 only to debug the boot check itself.
REQUIRE_SERVICE_ROLE=1

# ---------------------------------------------------------------------------
# LLMs — OpenRouter (chat) + DeepInfra (speech) — REQUIRED
# ---------------------------------------------------------------------------
# All chat completions go through OpenRouter, which speaks the OpenAI wire
# protocol — the `openai` SDK is used unchanged, just pointed at a different
# base_url. Nothing in this repo calls OpenAI or Azure any more.
#
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Override only to point at a mock or regional endpoint. Defaults to
# https://openrouter.ai/api/v1 — leave unset.
# OPENROUTER_BASE_URL=

# Two model tiers, both overridable without touching code. Defaults are
# DeepSeek; any OpenRouter slug works. See apps/api/models.py.
#   SMART = judgement calls and structured output (was gpt-4.1 / gpt-4o)
#   FAST  = high-volume mechanical work        (was gpt-4.1-mini / gpt-4o-mini)
# LLM_MODEL_SMART=deepseek/deepseek-v4-pro
# LLM_MODEL_FAST=deepseek/deepseek-v4-flash

# Optional, purely cosmetic: attributes usage on OpenRouter's public
# leaderboards. Omit and nothing changes.
# OPENROUTER_SITE_URL=https://langfive.com
# OPENROUTER_APP_NAME=Langfour

# Speech-to-text runs on DeepInfra, because OpenRouter proxies chat
# completions only and has no /audio/transcriptions endpoint. Needed solely by
# videoparsing.py — the rest of the API starts fine without it.
# https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=
# Override only to point at a mock. Defaults to
# https://api.deepinfra.com/v1/openai — leave unset.
# DEEPINFRA_BASE_URL=
# LLM_MODEL_TRANSCRIBE=openai/whisper-large-v3-turbo

# ---------------------------------------------------------------------------
# CORS — REQUIRED in production
# ---------------------------------------------------------------------------
# Comma-separated origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000,https://langfive.com,https://www.langfive.com
# Published extension ID, so chrome-extension://<id> is also accepted.
EXTENSION_ID=

# ---------------------------------------------------------------------------
# Transcript corpus — REQUIRED in production, optional locally
# ---------------------------------------------------------------------------
# corpus_sync.py streams one gzipped tarball per language onto local disk at
# startup (134 MB total; Spanish alone is 118 MB). Leave the source blank in
# local development and an existing data/processed/ is used as-is.
#
# Cloudflare R2, bucket "langfive-corpus" (Western Europe, private).
LANGFIVE_CORPUS_BUCKET=langfive-corpus
LANGFIVE_CORPUS_PREFIX=corpus/v1
LANGFIVE_CORPUS_ENDPOINT=https://a739b7b639d8e10c788645f3bab83f2f.r2.cloudflarestorage.com
AWS_REGION=auto

# Use the READ-ONLY token here (langfive-corpus-api-readonly). The API never
# writes to the bucket; uploads use a separate read-write token that stays on
# your laptop.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Alternative to the four vars above: a plain HTTPS prefix, no credentials.
# LANGFIVE_CORPUS_BASE_URL=https://<public-or-presigned-prefix>

# Fetch only what this deployment serves. Default: de,es,fr,it
# de+fr+it together are 16 MB; adding es makes it 134 MB.
# LANGFIVE_CORPUS_LANGUAGES=de,fr,it

# Relocate the corpus onto a mounted volume so it survives restarts.
# LANGFIVE_DATA_DIR=/mnt/langfive-data

# ---------------------------------------------------------------------------
# Maintenance scripts only — NOT needed to run the service
# ---------------------------------------------------------------------------
# scripts/ uses this for scraping video lists (extend_scrapelist.py,
# videolistcreation.py). The API itself never reads it.
# YOUTUBE_API_KEY=
