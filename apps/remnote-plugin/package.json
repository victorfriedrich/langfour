{
  "private": true,
  "name": "langfour-remnote-plugin",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Turns the words you save in Langfour into RemNote flashcards and reports your reviews back.",
  "scripts": {
    "dev": "cross-env NODE_ENV=development webpack serve --color",
    "build": "rm -rf dist && cross-env NODE_ENV=production webpack --color && cd dist && bestzip ../PluginZip.zip ./*",
    "check-types": "tsc",
    "test": "vitest run",
    "validate": "remnote-plugin validate"
  },
  "dependencies": {
    "@remnote/plugin-sdk": "0.0.46",
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
  "devDependencies": {
    "@types/react": "^17.0.2",
    "@types/react-dom": "^17.0.2",
    "bestzip": "^2.2.1",
    "copy-webpack-plugin": "^12.0.2",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "esbuild-loader": "^4.2.2",
    "glob": "^13.0.6",
    "html-webpack-plugin": "^5.6.0",
    "mini-css-extract-plugin": "^2.9.1",
    "style-loader": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.0",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  }
}
